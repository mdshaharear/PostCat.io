NEXT_PUBLIC_SITE_URL=https://postcat.io

# Dedicated PostCat PostgreSQL. Generate a long random value; never commit it.
POSTCAT_DB_PASSWORD=
POSTCAT_DB_APP_PASSWORD=
DATABASE_URL=postgresql://postcat:CHANGE-ME@database:5432/postcat

# Authorized affiliate APIs. Keep every credential server-only.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_CAMPAIGN_ID=
AMAZON_CREATORS_CREDENTIAL_ID=
AMAZON_CREATORS_CREDENTIAL_SECRET=
AMAZON_CREATORS_CREDENTIAL_VERSION=3.1
AMAZON_PARTNER_TAG=
AMAZON_MARKETPLACE=www.amazon.com

# Server-only Contabo Object Storage configuration.
CONTABO_S3_ENDPOINT=https://sin1.contabostorage.com
CONTABO_S3_REGION=default
CONTABO_S3_ACCESS_KEY_ID=
CONTABO_S3_SECRET_ACCESS_KEY=
CONTABO_S3_PRIVATE_BUCKET=postcat-prod-media-private-CHANGE-ME
CONTABO_S3_PUBLIC_BUCKET=
MEDIA_PUBLIC_BASE_URL=
CONTABO_S3_SIGNED_GET_TTL_SECONDS=300
CONTABO_S3_SIGNED_PUT_TTL_SECONDS=120
CONTABO_S3_MAX_UPLOAD_BYTES=10485760
